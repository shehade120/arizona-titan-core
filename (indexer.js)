/**
 * @file indexer.js
 * @description Inyector de conocimiento para el Proyecto Arizona Titan.
 * Lee archivos de la carpeta 'knowledge-base' y los registra en la base vectorial.
 */

import { ChromaClient } from 'chromadb';
import fs from 'fs';
import path from 'path';

async function runIndexer() {
    const client = new ChromaClient();
    const collection = await client.getOrCreateCollection({
        name: "titan-knowledge"
    });

    const dirPath = './knowledge-base';
    const files = fs.readdirSync(dirPath);

    console.log("--- Iniciando Ingesta de Datos al Búnker ---");

    for (const file of files) {
        if (file.endsWith('.md')) { // Solo procesamos archivos Markdown
            const filePath = path.join(dirPath, file);
            const content = fs.readFileSync(filePath, 'utf-8');

            // Agregamos el contenido a la memoria vectorial
            await collection.add({
                ids: [file],
                documents: [content],
                metadatas: [{ source: file, timestamp: new Date().toISOString() }]
            });

            console.log(`[ÉXITO] ${file} integrado al motor de agentes.`);
        }
    }
    console.log("--- Proceso completado: Búnker Digital actualizado ---");
}

runIndexer().catch(console.error);
